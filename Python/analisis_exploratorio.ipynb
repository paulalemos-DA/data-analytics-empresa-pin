TABLA TRANSACCIONES

query_transacciones = text("""CREATE TABLE Transacciones (
                         TransaccionID    INT PRIMARY KEY,
                         Fecha_Operacion  DATETIME,
                         EmpleadoID       VARCHAR(8),
                         ClienteID        VARCHAR(8),
                         ProductoID       VARCHAR(9),
                         SucursalID       VARCHAR(6),
                         Cantidad         INT,
                         Precio_Unitario  DECIMAL(10,2),
                         Forma_de_Pago    VARCHAR(50)
                    )""")
with engine.connect() as conn:
    conn.execute(query_transacciones)
    conn.commit()

Transacciones.columns = Transacciones.columns.str.replace(' ', '_')

#Reemplazar espacios por guion bajo:
Transacciones.rename(columns={
    'FechaOperacion': 'Fecha_Operacion',
    'PrecioUnitario': 'Precio_Unitario',
    'Forma de Pago': 'Forma_de_Pago'
}, inplace=True)

#Insertar datos
Transacciones.to_sql(
        name='Transacciones',
        con=engine,
        if_exists='append',
        index=True
    )
conn.commit()

transacciones_check= pd.read_sql("select * from transacciones limit 3", con=engine)
print(transacciones_check)

