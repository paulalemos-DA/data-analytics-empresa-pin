MIGRACION A MySQL

from sqlalchemy import create_engine
from sqlalchemy.exc import SQLAlchemyError
from sqlalchemy import text

db_usuario = "root"
db_contraseña = input('Ingrese contraseña')           
db_host = "localhost"                    
db_puerto = "3306"   
db_nombre= "empresa" 

cadena_conexion = f"mysql+mysqlconnector://{db_usuario}:{db_contraseña}@{db_host}:{db_puerto}/{db_nombre}"
engine = create_engine(cadena_conexion)


try:
    conn = engine.connect()
    print ("Conexion a la base de datos MySQL exitosa")
except SQLAlchemyError as e:
    error = str(e.__dict__['orig'])
    print ("Error al conectar a la base de datos MySQL")
    print (error)
  Conexion a la base de datos MySQL exitosa


TABLA CLIENTES

query_clientes =text("""CREATE TABLE Clientes (
                  ClienteID    VARCHAR(8) PRIMARY KEY,
                  Nombre       VARCHAR(100),
                  Apellido     VARCHAR(100),
                  Mail         VARCHAR (150),
                  Telefono     VARCHAR(50),
                  Ciudad       VARCHAR(100),
                  Pais         VARCHAR(50),
                  TipoCliente  VARCHAR(50)
                )""")
with engine.connect() as conn:
    conn.execute(query_clientes)
    conn.commit()

